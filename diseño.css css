body {
    background-color: #d3d3d3; /* gris claro */
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    text-align: center;
}

marquee {
    background-color: #000;
    color: #fff;
    padding: 10px;
    font-weight: bold;
    font-size: 1.2em;
}

nav ul {
    background-color: #333;
    padding: 10px 0;
    margin: 0;
    list-style: none;
    display: flex;
    justify-content: center;
}

nav ul li {
    margin: 0 15px;
}

nav ul li a {
    color: white;
    text-decoration: none;
    font-weight: bold;
}

header h1 {
    color: #222;
    margin-top: 20px;
}

.imagen-portada {
    width: 60%;
    max-width: 500px;
    height: auto;
    margin-top: 20px;
    border-radius: 10px;
}

section {
    margin-top: 30px;
    padding: 20px;
}

.boton-container {
    margin: 30px;
}

button {
    padding: 10px 20px;
    font-size: 16px;
    cursor: pointer;
    border: none;
    background-color: #0055a5;
    color: white;
    border-radius: 5px;
    transition: background-color 0.3s ease;
}

button:hover {
    background-color: #003d7a;
}
